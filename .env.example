PORT=3000
DATA_DIR=./data
DOCLING_URL=http://localhost:5001
# modelo de embedding local (Transformers.js); ver apps/api/src/embed/registry.ts
EMBED_MODEL=e5-small-q8
# provedor default quando o cliente não envia X-LLM-*: mock | anthropic | openai | google | openai-compatible | claude-code
# claude-code = CLI do Claude Code logado nesta máquina (`claude -p`, sem chave; só desenvolvimento/pesquisa). Caminho do binário se não estiver no PATH, ou "off" para desativar:
CLAUDE_CLI_PATH=
LLM_DEFAULT_KIND=mock
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_API_KEY=
LOG_LEVEL=info
